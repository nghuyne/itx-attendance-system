# ============================================================
# ITX Attendance System — Environment Variables
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control.
# ============================================================

# ----- Database -----
DB_ROOT_PASSWORD=change_me_root_password
DB_USERNAME=root
DB_PASSWORD=change_me_db_password

# ----- MinIO Object Storage -----
MINIO_ACCESS_KEY=change_me_minio_user
MINIO_SECRET_KEY=change_me_minio_password

# ----- JWT (minimum 32 characters, randomly generated) -----
JWT_SECRET=change_me_jwt_secret_minimum_32_characters_long

# ----- CORS (comma-separated list of allowed frontend origins) -----
# Development: http://localhost:5173
# Production:  https://your-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ----- Admin bootstrap -----
# One-time password for the seeded 'admin' account, used ONLY on first boot
# against an empty users table (see AdminUserSeeder.java). Leave unset to get
# a random password instead, printed once to the backend startup log — if you
# lose it, reset it directly in the DB rather than restarting the container.
ADMIN_BOOTSTRAP_PASSWORD=change_me_admin_bootstrap_password

# ----- Mail (optional) -----
# Real SMTP. Leave MAIL_USERNAME/MAIL_PASSWORD unset only if you don't need email
# (account creation / password reset mail will then fail — see EmailService logs + audit log).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@itx.local

# ----- Spring profile -----
# Leave unset for a real deployment (docker-compose up): real SMTP above, ip-check enforced,
# CORS_ALLOWED_ORIGINS honored. Only set to "dev" when running with
# docker-compose.dev.yml for local testing against MailHog.
SPRING_PROFILES_ACTIVE=

# ----- Backend container memory limit (docker-compose.yml) -----
# Default 768m if unset. Tune to match the real VPS's available RAM;
# JDK_JAVA_OPTIONS' -XX:MaxRAMPercentage is set relative to this limit.
BACKEND_MEM_LIMIT=768m
